<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="com.punam.hibernate.EmployeeInheritanceSingleTable.Employee"
           table="employee_inheritance">

        <id name="id" column="id">
            <generator class="assigned"/>
        </id>

        <discriminator column="employee_type" type="string"/>

        <property name="name" column="name"/>
        <property name="salary" column="salary"/>

        <subclass name="com.punam.hibernate.EmployeeInheritanceSingleTable.Manager" discriminator-value="MANAGER">

            <property name="department" column="department"/>

        </subclass>

        <subclass name="com.punam.hibernate.EmployeeInheritanceSingleTable.Developer" discriminator-value="DEVELOPER">

            <property name="programmingLanguage" column="programming_language"/>

        </subclass>

    </class>

</hibernate-mapping>