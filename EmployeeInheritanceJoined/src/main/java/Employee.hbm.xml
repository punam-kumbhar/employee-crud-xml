<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="com.punam.hibernate.EmployeeInheritanceJoined.Employee"
           table="employee_joined">

        <id name="id" column="id">
            <generator class="assigned"/>
        </id>

        <property name="name" column="name"/>
        <property name="salary" column="salary"/>

        <joined-subclass name="com.punam.hibernate.EmployeeInheritanceJoined.Manager" table="manager_joined">

            <key column="id"/>

            <property name="department" column="department"/>

        </joined-subclass>

        <joined-subclass
            name="com.punam.hibernate.EmployeeInheritanceJoined.Developer" table="developer_joined">

            <key column="id"/>

            <property name="programmingLanguage" column="programming_language"/>

        </joined-subclass>

    </class>

</hibernate-mapping>